# Settings for Baby Companion.
# Copy this file to ".env" (cp env.example .env) and adjust. docker compose reads .env automatically.

# Password for the whole app (web, API and /mcp). Strongly recommended if you
# open the app from outside your home network (e.g. through a Cloudflare tunnel).
APP_PASSWORD=

# Local AI model served by Ollama on the host. llama3.1:8b is recommended
# (about 6 GB of RAM while answering); llama3.2 (3B) is faster but less reliable.
OLLAMA_MODEL=llama3.1:8b

# Speech-to-text model size for faster-whisper: tiny, base, small, medium.
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

# Your region, health advice line and emergency number (used in safety messages).
REGION=Alberta
HEALTH_LINE=Health Link 811
HEALTH_LINE_NUMBER=811
EMERGENCY_NUMBER=911

# Default time zone when the browser doesn't send one.
DEFAULT_TZ=America/Edmonton
